// Datenbankschema – Phase 1 (Accounts, Spiele, Store, Bibliothek, Admin)
// Spätere Phasen ergänzen weitere Modelle über neue Migrationen.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  UPLOADER
  USER
}

enum SessionKind {
  WEB
  DEVICE
}

enum GameVisibility {
  PUBLIC // im Store sichtbar
  UNLISTED // nur per Direktlink
  RESTRICTED // nur für freigegebene Nutzer
  HIDDEN // nur Admins/Maintainer (Entwurf)
}

enum Platform {
  WINDOWS
  LINUX
  MACOS
}

enum BuildKind {
  ZIP
  SEVEN_ZIP
  FOLDER
  INSTALLER
}

enum LinuxRunner {
  NONE
  PROTON
  WINE
}

enum BuildStatus {
  DRAFT
  READY
}

enum UploadStatus {
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum MediaKind {
  COVER
  HEADER
  BACKGROUND
  SCREENSHOT
  ARTWORK
}

enum DiscoveryAction {
  SKIPPED
  WISHLISTED
  ADDED
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  email            String    @unique
  passwordHash     String?
  role             Role      @default(USER)
  displayName      String?
  bio              String?
  avatarKey        String?
  locale           String    @default("de")
  disabled         Boolean   @default(false)
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  totpLastCounter  Int?
  recoveryCodes    String[]  @default([])
  oidcSubject      String?   @unique
  // Föderation Stufe 2: Schatten-Konto eines Nutzers von einem verbundenen Heimat-Server.
  federationServerId String?
  federationServer   FederatedServer? @relation("FederatedUsers", fields: [federationServerId], references: [id], onDelete: SetNull)
  federationUserId   String?
  uploadQuotaBytes BigInt?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  sessions        Session[]
  loginChallenges LoginChallenge[]
  resetTokens     PasswordResetToken[]
  invitesCreated  Invite[]             @relation("InviteCreator")
  invitedBy       Invite?              @relation("InviteUsedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById     String?
  gamesCreated    Game[]               @relation("GameCreator")
  maintainerOf    GameMaintainer[]
  accessTo        GameAccess[]
  uploads         Upload[]
  library         LibraryEntry[]
  collections     Collection[]
  wishlist        WishlistEntry[]
  discoveryViews  DiscoveryView[]
  playSessions    PlaySession[]
  announcements   Announcement[]
  auditLogs       AuditLog[]
  downloads       DownloadEvent[]
  buildFiles      BuildFile[]

  // ---- Phase 3: Soziales ----
  profileBackgroundKey   String?
  profileAccent          String?
  profileVisibility      ProfileVisibility    @default(PUBLIC)
  allowFriendRequests    Boolean              @default(true)
  /// Vitrinen auf der Profilseite (JSON-Liste)
  showcases              Json                 @default("[]")
  /// Benachrichtigungseinstellungen (JSON)
  notificationPrefs      Json                 @default("{}")
  lastSeenAt             DateTime?
  friendRequestsSent     Friendship[]         @relation("FriendRequester")
  friendRequestsReceived Friendship[]         @relation("FriendAddressee")
  blocking               Block[]              @relation("Blocker")
  blockedBy              Block[]              @relation("Blocked")
  conversationsCreated   Conversation[]       @relation("ConversationCreator")
  conversationMembers    ConversationMember[]
  messages               Message[]
  groupsCreated          Group[]              @relation("GroupCreator")
  groupMemberships       GroupMember[]
  groupAnnouncements     GroupAnnouncement[]
  groupEvents            GroupEvent[]
  eventRsvps             GroupEventRsvp[]
  reviews                Review[]
  reviewVotes            ReviewVote[]
  forumTopics            ForumTopic[]
  forumPosts             ForumPost[]
  communityItems         CommunityItem[]
  communityLikes         CommunityLike[]
  notifications          Notification[]
  activities             Activity[]

  // ---- Phase 4 ----
  /// Erfahrungspunkte für das Profil-Level (Abzeichen herstellen, Achievements)
  xp                    Int                    @default(0)
  cloudSaves            CloudSave[]
  achievements          UserAchievement[]
  gameTokens            GameToken[]
  workshopItems         WorkshopItem[]
  workshopRatings       WorkshopRating[]
  workshopComments      WorkshopComment[]
  workshopSubscriptions WorkshopSubscription[]
  cards                 CardItem[]
  cardDrops             CardDropState[]
  badges                GameBadge[]
  tradesSent            TradeOffer[]           @relation("TradeFrom")
  tradesReceived        TradeOffer[]           @relation("TradeTo")
  marketListings        MarketListing[]        @relation("MarketSeller")
  familyMember          FamilyMember?
  familyInvites         FamilyInvite[]
  giftsSent             Gift[]                 @relation("GiftFrom")
  giftsReceived         Gift[]                 @relation("GiftTo")
  codesCreated          ActivationCode[]
  codeRedemptions       CodeRedemption[]
  gameNotes             GameNote[]

  @@unique([federationServerId, federationUserId])
}

model Session {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  kind       SessionKind
  name       String?
  userAgent  String?
  ip         String?
  csrfToken  String?
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime    @default(now())
  expiresAt  DateTime
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginChallenge {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       SessionKind
  deviceName String?
  attempts   Int         @default(0)
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role      @default(USER)
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  note        String?
  expiresAt   DateTime?
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("InviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy      User[]    @relation("InviteUsedBy")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Genre {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  games Game[]
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  games Game[]
}

model Game {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  shortDescription   String         @default("")
  description        String         @default("")
  developer          String?
  publisher          String?
  releaseDate        DateTime?
  website            String?
  trailerUrls        String[]       @default([])
  systemRequirements Json           @default("{}")
  visibility         GameVisibility @default(HIDDEN)
  featured           Boolean        @default(false)
  igdbId             String?
  rawgId             String?
  downloadCount      Int            @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  publishedAt        DateTime?
  createdById        String?
  createdBy          User?          @relation("GameCreator", fields: [createdById], references: [id], onDelete: SetNull)

  genres          Genre[]
  tags            Tag[]
  media           GameMedia[]
  versions        GameVersion[]
  maintainers     GameMaintainer[]
  access          GameAccess[]
  libraryEntries  LibraryEntry[]
  wishlistEntries WishlistEntry[]
  discoveryViews  DiscoveryView[]
  playSessions    PlaySession[]
  collections     CollectionGame[]
  announcements   Announcement[]
  downloads       DownloadEvent[]
  reviews         Review[]
  forumTopics     ForumTopic[]
  communityItems  CommunityItem[]
  groupEvents     GroupEvent[]
  activities      Activity[]

  // ---- Phase 4 ----
  /// Save-Pfade für Cloud-Saves: [{ platform: "WINDOWS"|"LINUX"|"ANY", path, include?, exclude? }]
  savePaths       Json             @default("[]")
  /// Workshop-Inhalte werden nach <Installationsordner>/<workshopPath>/<itemId>/ entpackt (null = Workshop aus)
  workshopPath    String?
  /// Altersfreigabe (0, 6, 12, 16, 18)
  ageRating       Int              @default(0)
  cloudSaves      CloudSave[]
  achievements    Achievement[]
  gameTokens      GameToken[]
  workshopItems   WorkshopItem[]
  tradingCards    TradingCard[]
  cardDrops       CardDropState[]
  badges          GameBadge[]
  gifts           Gift[]
  activationCodes ActivationCode[]
  notes           GameNote[]

  @@index([visibility, publishedAt])
}

model GameMedia {
  id         String    @id @default(cuid())
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind       MediaKind
  storageKey String
  mimeType   String
  size       Int
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([gameId, kind])
}

model GameMaintainer {
  gameId    String
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([gameId, userId])
}

model GameAccess {
  gameId    String
  userId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([gameId, userId])
}

model GameVersion {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version     String
  changelog   String    @default("")
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  builds      Build[]

  @@unique([gameId, version])
}

model Build {
  id            String      @id @default(cuid())
  versionId     String
  version       GameVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  platform      Platform
  kind          BuildKind
  status        BuildStatus @default(DRAFT)
  executable    String      @default("")
  launchArgs    String      @default("")
  workingDir    String      @default("")
  installerArgs String      @default("")
  linuxRunner   LinuxRunner @default(NONE)
  installSize   BigInt      @default(0)
  totalSize     BigInt      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  files         BuildFile[]
  uploads       Upload[]

  @@unique([versionId, platform])
}

model BuildFile {
  id           String   @id @default(cuid())
  buildId      String
  build        Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  path         String
  size         BigInt
  sha256       String
  storageKey   String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([buildId, path])
  @@index([uploadedById])
}

model Upload {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildId        String
  build          Build        @relation(fields: [buildId], references: [id], onDelete: Cascade)
  path           String
  size           BigInt
  offset         BigInt       @default(0)
  expectedSha256 String?
  sha256         String?
  status         UploadStatus @default(ACTIVE)
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, status])
}

model LibraryEntry {
  userId          String
  gameId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  favorite        Boolean   @default(false)
  hidden          Boolean   @default(false)
  playtimeSeconds Int       @default(0)
  lastPlayedAt    DateTime?
  addedAt         DateTime  @default(now())

  @@id([userId, gameId])
  @@index([gameId])
}

model Collection {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  games     CollectionGame[]

  @@unique([userId, name])
}

model CollectionGame {
  collectionId String
  gameId       String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@id([collectionId, gameId])
}

model WishlistEntry {
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, gameId])
}

model DiscoveryView {
  userId String
  gameId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  action DiscoveryAction
  seenAt DateTime        @default(now())

  @@id([userId, gameId])
}

model PlaySession {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime
  seconds   Int

  @@index([userId, startedAt])
  @@index([gameId, startedAt])
}

model DownloadEvent {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  buildId   String?
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  published Boolean  @default(true)
  pinned    Boolean  @default(false)
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model Backup {
  id            String       @id @default(cuid())
  filename      String       @unique
  size          BigInt       @default(0)
  includesFiles Boolean      @default(false)
  status        BackupStatus @default(RUNNING)
  error         String?
  createdAt     DateTime     @default(now())
  finishedAt    DateTime?
}

// ---- Phase 2: Desktop-Client-Releases (Auto-Update über den eigenen Server) ----

enum ClientFileFormat {
  MSI
  NSIS
  APPIMAGE
  DEB
  RPM
  DMG
  APP_TARBALL
}

model ClientRelease {
  id          String              @id @default(cuid())
  version     String              @unique
  notes       String              @default("")
  published   Boolean             @default(false)
  publishedAt DateTime?
  createdAt   DateTime            @default(now())
  files       ClientReleaseFile[]
}

model ClientReleaseFile {
  id         String           @id @default(cuid())
  releaseId  String
  release    ClientRelease    @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  platform   Platform
  arch       String           @default("x86_64")
  format     ClientFileFormat
  filename   String
  size       BigInt
  sha256     String
  storageKey String
  /// Inhalt der .sig-Datei (Tauri-Updater-Signatur); nur Dateien mit Signatur werden als Update angeboten
  signature  String?
  createdAt  DateTime         @default(now())

  @@unique([releaseId, platform, arch, format])
}

// ---- Phase 3: Soziales ----

enum ProfileVisibility {
  PUBLIC
  FRIENDS
  PRIVATE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL
}

model Conversation {
  id            String               @id @default(cuid())
  type          ConversationType
  title         String?
  /// Eindeutiger Schlüssel für Direktnachrichten (sortierte Nutzer-IDs)
  directKey     String?              @unique
  groupId       String?
  group         Group?               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime             @default(now())
  members       ConversationMember[]
  messages      Message[]

  @@index([groupId])
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAdmin        Boolean      @default(false)
  muted          Boolean      @default(false)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String       @default("")
  attachmentKey  String?
  attachmentMime String?
  gifUrl         String?
  // Föderation Stufe 3: Herkunfts-ID einer über einen anderen Server zugestellten Nachricht (Dedup).
  federationId   String?      @unique
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

enum GroupJoinPolicy {
  OPEN
  REQUEST
  INVITE
}

enum GroupVisibility {
  PUBLIC
  HIDDEN
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupMemberStatus {
  ACTIVE
  PENDING
  INVITED
}

model Group {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  summary       String              @default("")
  description   String              @default("")
  avatarKey     String?
  bannerKey     String?
  joinPolicy    GroupJoinPolicy     @default(OPEN)
  visibility    GroupVisibility     @default(PUBLIC)
  createdById   String?
  createdBy     User?               @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  members       GroupMember[]
  announcements GroupAnnouncement[]
  events        GroupEvent[]
  channels      Conversation[]
}

model GroupMember {
  groupId  String
  userId   String
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole         @default(MEMBER)
  status   GroupMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model GroupAnnouncement {
  id        String   @id @default(cuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  body      String
  createdAt DateTime @default(now())
}

model GroupEvent {
  id          String           @id @default(cuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String           @default("")
  startsAt    DateTime
  endsAt      DateTime?
  gameId      String?
  game        Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  reminded    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  rsvps       GroupEventRsvp[]

  @@index([groupId, startsAt])
}

enum RsvpStatus {
  GOING
  MAYBE
  DECLINED
}

model GroupEventRsvp {
  eventId String
  userId  String
  event   GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status  RsvpStatus

  @@id([eventId, userId])
}

model Review {
  id               String       @id @default(cuid())
  gameId           String
  userId           String
  game             Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommended      Boolean
  body             String
  playtimeAtReview Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  votes            ReviewVote[]

  @@unique([gameId, userId])
  @@index([gameId, createdAt])
}

model ReviewVote {
  reviewId String
  userId   String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful  Boolean
  funny    Boolean @default(false)

  @@id([reviewId, userId])
}

model ForumTopic {
  id         String      @id @default(cuid())
  gameId     String
  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title      String
  pinned     Boolean     @default(false)
  locked     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  lastPostAt DateTime    @default(now())
  posts      ForumPost[]

  @@index([gameId, lastPostAt])
}

model ForumPost {
  id        String     @id @default(cuid())
  topicId   String
  topic     ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime   @default(now())
  editedAt  DateTime?

  @@index([topicId, createdAt])
}

enum CommunityItemType {
  SCREENSHOT
  ARTWORK
  GUIDE
}

model CommunityItem {
  id        String            @id @default(cuid())
  gameId    String
  game      Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type      CommunityItemType
  title     String
  body      String            @default("")
  imageKey  String?
  imageMime String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  likes     CommunityLike[]

  @@index([gameId, type, createdAt])
}

model CommunityLike {
  itemId    String
  userId    String
  item      CommunityItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([itemId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json      @default("{}")
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  data      Json     @default("{}")
  gameId    String?
  game      Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- Phase 4: Steam-Funktionen ----

model CloudSave {
  id          String    @id @default(cuid())
  userId      String
  gameId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  version     Int
  storageKey  String
  size        BigInt
  /// Inhaltskennung: SHA-256 über das sortierte Manifest
  contentHash String
  /// [{ root, path, size, sha256, mtime }]
  manifest    Json
  deviceName  String?
  platform    Platform?
  createdAt   DateTime  @default(now())

  @@unique([userId, gameId, version])
  @@index([userId, gameId, createdAt])
}

model Achievement {
  id          String            @id @default(cuid())
  gameId      String
  game        Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// Stabile Kennung für SDK-Aufrufe (z. B. "FIRST_BLOOD")
  apiName     String
  name        String
  description String            @default("")
  iconKey     String?
  hidden      Boolean           @default(false)
  sortOrder   Int               @default(0)
  /// Zielwert für Fortschritts-Achievements (null = einfach freischalten)
  progressMax Int?
  /// Optionale Erkennung durch den Client: { type: "file_exists"|"file_regex"|"log_regex", path, pattern? }
  detection   Json?
  createdAt   DateTime          @default(now())
  unlocks     UserAchievement[]

  @@unique([gameId, apiName])
  @@index([gameId, sortOrder])
}

model UserAchievement {
  userId        String
  achievementId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  progress      Int         @default(0)
  unlockedAt    DateTime?
  /// sdk | detect | admin
  source        String      @default("sdk")

  @@id([userId, achievementId])
  @@index([achievementId, unlockedAt])
  @@index([userId, unlockedAt])
}

/// Kurzlebiges Token pro Spielstart für das Achievement-SDK (nur ein Spiel, nur SDK-Endpunkte)
model GameToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}

enum WorkshopKind {
  MOD
  MAP
  OTHER
}

model WorkshopItem {
  id            String                 @id @default(cuid())
  gameId        String
  game          Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  authorId      String?
  author        User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title         String
  description   String                 @default("")
  kind          WorkshopKind           @default(MOD)
  tags          String[]               @default([])
  previewKey    String?
  /// Von Moderation ausgeblendet
  hidden        Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  versions      WorkshopVersion[]
  ratings       WorkshopRating[]
  comments      WorkshopComment[]
  subscriptions WorkshopSubscription[]

  @@index([gameId, createdAt])
}

model WorkshopVersion {
  id        String       @id @default(cuid())
  itemId    String
  item      WorkshopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version   String
  changelog String       @default("")
  fileKey   String
  fileName  String
  size      BigInt
  sha256    String
  createdAt DateTime     @default(now())

  @@unique([itemId, version])
  @@index([itemId, createdAt])
}

model WorkshopRating {
  itemId String
  userId String
  item   WorkshopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  up     Boolean

  @@id([itemId, userId])
}

model WorkshopComment {
  id        String       @id @default(cuid())
  itemId    String
  item      WorkshopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime     @default(now())

  @@index([itemId, createdAt])
}

model WorkshopSubscription {
  itemId    String
  userId    String
  item      WorkshopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([itemId, userId])
  @@index([userId])
}

model TradingCard {
  id        String          @id @default(cuid())
  gameId    String
  game      Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name      String
  imageKey  String?
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  items     CardItem[]
  wantedIn  MarketListing[] @relation("MarketWant")

  @@index([gameId, sortOrder])
}

model CardItem {
  id         String           @id @default(cuid())
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cardId     String
  card       TradingCard      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  foil       Boolean          @default(false)
  /// drop | trade | market | admin
  source     String           @default("drop")
  acquiredAt DateTime         @default(now())
  tradeItems TradeOfferItem[]
  listing    MarketListing?   @relation("MarketItem")

  @@index([ownerId, cardId])
}

model CardDropState {
  userId          String
  gameId          String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  drops           Int    @default(0)
  /// Bereits für Drops angerechnete Spielzeit (Sekunden)
  creditedSeconds Int    @default(0)

  @@id([userId, gameId])
}

model GameBadge {
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  level     Int      @default(0)
  foil      Boolean  @default(false)
  craftedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, gameId])
}

enum TradeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum TradeSide {
  GIVE
  RECEIVE
}

model TradeOffer {
  id        String           @id @default(cuid())
  fromId    String
  toId      String
  from      User             @relation("TradeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User             @relation("TradeTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String           @default("")
  status    TradeStatus      @default(PENDING)
  createdAt DateTime         @default(now())
  decidedAt DateTime?
  items     TradeOfferItem[]

  @@index([toId, status])
  @@index([fromId, status])
}

model TradeOfferItem {
  offerId String
  itemId  String
  offer   TradeOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  item    CardItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  side    TradeSide

  @@id([offerId, itemId])
}

enum ListingStatus {
  OPEN
  COMPLETED
  CANCELLED
}

/// Marktplatz ohne Geld: „biete Karte X, suche Karte Y“
model MarketListing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemId      String        @unique
  item        CardItem      @relation("MarketItem", fields: [itemId], references: [id], onDelete: Cascade)
  wantCardId  String
  wantCard    TradingCard   @relation("MarketWant", fields: [wantCardId], references: [id], onDelete: Cascade)
  status      ListingStatus @default(OPEN)
  buyerId     String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  @@index([status, wantCardId])
}

model FamilyGroup {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  members   FamilyMember[]
  invites   FamilyInvite[]
}

enum FamilyRole {
  ADULT
  CHILD
}

model FamilyMember {
  familyId         String
  userId           String      @unique
  family           FamilyGroup @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             FamilyRole
  joinedAt         DateTime    @default(now())
  // Kindersicherung (nur für CHILD wirksam)
  maxAgeRating     Int         @default(18)
  /// Tägliches Spielzeitlimit in Minuten (null = unbegrenzt)
  dailyMinutes     Int?
  chatAllowed      Boolean     @default(true)
  communityAllowed Boolean     @default(true)

  @@id([familyId, userId])
}

model FamilyInvite {
  id        String      @id @default(cuid())
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      FamilyRole
  createdAt DateTime    @default(now())

  @@unique([familyId, userId])
}

model Gift {
  id        String    @id @default(cuid())
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  fromId    String?
  from      User?     @relation("GiftFrom", fields: [fromId], references: [id], onDelete: SetNull)
  toId      String
  to        User      @relation("GiftTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String    @default("")
  createdAt DateTime  @default(now())
  openedAt  DateTime?

  @@index([toId, openedAt])
}

model ActivationCode {
  id          String           @id @default(cuid())
  code        String           @unique
  gameId      String
  game        Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  batch       String           @default("")
  note        String           @default("")
  maxUses     Int              @default(1)
  uses        Int              @default(0)
  expiresAt   DateTime?
  revoked     Boolean          @default(false)
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  redemptions CodeRedemption[]

  @@index([gameId, batch])
}

model CodeRedemption {
  codeId     String
  userId     String
  code       ActivationCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime       @default(now())

  @@id([codeId, userId])
}

model GameNote {
  userId    String
  gameId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  body      String   @default("")
  updatedAt DateTime @updatedAt

  @@id([userId, gameId])
}

// ---------------------------------------------------------------------------
// Föderation (Stufe 1): mehrere Server zu einem Netzwerk verbinden.
// Spiele bleiben auf ihrem Herkunftsserver; verbundene Server zeigen den
// Katalog und liefern Downloads per signierter, direkter Datei-URL aus.
// ---------------------------------------------------------------------------

enum FederationStatus {
  PENDING // ausgehend angefragt, vom Peer noch nicht bestätigt
  ACTIVE
  BLOCKED
}

model FederatedServer {
  id           String           @id @default(cuid())
  name         String // Anzeigename, vom Peer gemeldet
  baseUrl      String           @unique // z. B. https://games.example.com (ohne abschließenden /)
  publicKey    String // Ed25519-Public-Key des Peers (base64, SPKI/PEM)
  status       FederationStatus @default(ACTIVE)
  lastSyncedAt DateTime?
  lastError    String?
  catalog      Json             @default("[]") // zwischengespeicherter Remote-Katalog (RemoteGameDto[])
  // Fern-Administration (beidseitiges Opt-in):
  adminGranted Boolean          @default(false) // WIR erlauben DIESEM Peer, uns fernzuverwalten
  adminAllowed Boolean          @default(false) // dieser Peer erlaubt UNS, ihn fernzuverwalten (zwischengespeichert aus Sync)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  users User[] @relation("FederatedUsers")

  @@index([status])
}
