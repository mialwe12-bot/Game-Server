{
  "name": "@gameserver/sdk",
  "version": "0.4.0",
  "description": "Achievement-SDK für Spiele auf einer selbst gehosteten Game-Server-Plattform",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "source": "./src/index.ts",
