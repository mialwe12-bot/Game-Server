# ============================================================
# Game Server – Konfiguration (.env)
# Kopieren nach .env und anpassen: cp .env.example .env
# ============================================================

# Öffentliche URL der Plattform (für Links in E-Mails, Einladungen, SSO-Redirect)
PUBLIC_URL=https://games.example.com

# --- Datenbank (wird von docker-compose für Postgres UND Server verwendet) ---
POSTGRES_DB=gameserver
POSTGRES_USER=gameserver
# Nur URL-sichere Zeichen verwenden, z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=bitte-aendern

# Für lokale Entwicklung ohne Docker (pnpm dev):
# DATABASE_URL=postgresql://gameserver:bitte-aendern@localhost:5432/gameserver
# DATA_DIR=./data

# Speicherort für Spieldateien/Medien/Backups auf dem Host (Bind-Mount nach /data)
DATA_PATH=./data

# --- Sicherheit ---
# Cookies nur über HTTPS senden (hinter Caddy mit TLS: true)
COOKIE_SECURE=true
# Gültigkeit von Web-Sessions bzw. Device-Tokens des Desktop-Clients (Tage, gleitend verlängert)
SESSION_TTL_DAYS=30
DEVICE_TTL_DAYS=365
# Rate-Limits (Anfragen pro Minute und IP)
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
# Erlaubte Origins für den Desktop-Client (Tauri), kommagetrennt
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

LOG_LEVEL=info

# --- E-Mail (Passwort-Reset, Test-Mail) – leer lassen, um E-Mail zu deaktivieren ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Game Server <noreply@example.com>"

# --- Optional: Single Sign-On (OpenID Connect, z. B. Authentik, Keycloak, Authelia) ---
# Redirect-URI beim Anbieter eintragen: ${PUBLIC_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO
OIDC_SCOPES=openid email profile
# Neue SSO-Nutzer automatisch anlegen (sofern Registrierung nicht "geschlossen")
OIDC_AUTO_REGISTER=true
# Bestehende lokale Konten per verifizierter E-Mail verknüpfen
OIDC_LINK_BY_EMAIL=false
# Mitglieder dieser Gruppe (Claim "groups") werden Admin
OIDC_ADMIN_GROUP=

# --- Optional: Metadaten-Import ---
# RAWG: kostenloser Key unter https://rawg.io/apidocs
RAWG_API_KEY=
# IGDB: Twitch-Anwendung unter https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Erster Admin (nur für das Seed-Skript, danach entfernen) ---
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
