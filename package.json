{
  "name": "gameserver",
  "private": true,
  "version": "0.1.0",
  "description": "Selbst gehostete, DRM-freie Open-Source-Spieleplattform (Server, Web-Store, Admin-Panel, Desktop-Client)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gameserver/server --filter @gameserver/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @gameserver/server db:migrate",
    "seed": "pnpm --filter @gameserver/server seed"
  }
}
